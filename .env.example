# Application Settings
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development
SERVICE_NAME=rag-api

# PostgreSQL Database Configuration
POSTGRES_DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/rag_db
POSTGRES_ECHO_SQL=false
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=0

# OpenSearch Configuration
OPENSEARCH_HOST=http://opensearch:9200
OPENSEARCH_INDEX_NAME=arxiv-papers

# Week 4 Retrieval Configuration
# Model loading, chunking, and chunk-index creation are introduced in later milestones.
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
OPENSEARCH_CHUNK_INDEX_NAME=arxiv-papers-chunks
CHUNK_TARGET_WORDS=600
CHUNK_OVERLAP_WORDS=100
CHUNK_MIN_WORDS=100

# Week 5 LLM Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# arXiv API Configuration
ARXIV_API_BASE_URL=https://export.arxiv.org/api/query
ARXIV_SEARCH_CATEGORY=cs.AI
ARXIV_MAX_RESULTS=10
ARXIV_RATE_LIMIT_DELAY=3.0
ARXIV_TIMEOUT=30.0
ARXIV_MAX_RETRIES=3
ARXIV_PDF_CACHE_DIR=data/arxiv_pdfs

# PDF Parser Configuration
PDF_PARSER_MAX_FILE_SIZE_MB=50
PDF_PARSER_MAX_PAGES=100

# Scheduled arXiv Ingestion Configuration
ARXIV_INGESTION_PROFILES=ai,healthcare_ai,health_equity_tech
ARXIV_INGESTION_BATCH_SIZE=1
ARXIV_INGESTION_SCHEDULE=0 3 * * *
ARXIV_INGESTION_PROCESS_PDFS=true

# Airflow Configuration
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true
AIRFLOW__HOME=/opt/airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://rag_user:rag_password@postgres:5432/rag_db
